package stashd:plugin@0.17.0;

/// Lifecycle-independent plugin value contracts. Metadata facets remain in
/// `io-host` with the shared host-managed I/O boundary.
interface plugin-types {
    /// Plugin-owned diagnostic detail attached to lifecycle-specific error
    /// variants. The lifecycle variants themselves remain separate.
    record plugin-error-detail {
        message: string,
        retryable: bool,
    }
}

/// Shared progress callback and value for lifecycles that report progress.
interface progress-host {
    /// A fractional completion value in [0.0, 1.0] for this reported work.
    /// `none` is indeterminate/stage-only. Invalid fractions fail the active
    /// invocation; no universal cross-callback monotonicity rule applies. See
    /// protocol/shared-values.md.
    record progress {
        stage: string,
        fraction: option<f64>,
    }
    report-progress: func(progress: progress);
}

/// Invocation-scoped diagnostic logging shared by every plugin lifecycle.
interface logging-host {
    log: func(message: string);
}

/// Generic outbound HTTP capability shared by Input, Broadcast, and
/// Enrichment. The host applies only references authorized for the current
/// invocation and available at use time, without exposing secret material.
interface http-host {
    use io-host.{byte-stream, credential-reference};

    /// HTTP method names are case-sensitive tokens. The host validates the
    /// value as one or more ASCII `tchar` characters before dispatching it;
    /// invalid syntax is rejected before the HTTP operation is attempted.
    /// This remains open to standard, WebDAV, and extension methods.
    record http-header {
        name: string,
        value: string,
    }

    /// A request body is absent or is consumed from one invocation-scoped
    /// host byte stream. The host takes ownership and reads chunks until EOF.
    /// Header names and values are passed through the existing generic model;
    /// conditional and range requests require no special WIT fields.
    record http-request {
        method: string,
        url: string,
        /// The host rejects references not granted to this invocation and
        /// rechecks authorization and availability for each use.
        credential: option<credential-reference>,
        headers: list<http-header>,
        body: option<byte-stream>,
    }

    record http-response {
        status: u16,
        headers: list<http-header>,
        body: byte-stream,
    }

    /// Redirect following is host/runtime policy, not a plugin or SDK default.
    /// For every hop the host re-evaluates URL policy and credential
    /// authorization. Credentials are not forwarded to a new authority unless
    /// that policy explicitly permits the reference for the target. A streamed
    /// body is followed only when the host can safely replay it; otherwise the
    /// host returns a typed HTTP error rather than silently dropping or
    /// replaying the body.

    variant http-error {
        denied,
        credential-unavailable,
        authentication-rejected,
        rate-limited,
        body-failed(string),
        unavailable(string),
        failed(string),
    }

    resource http-client {
        request: func(request: http-request) -> result<http-response, http-error>;
    }

    open-http-client: func() -> http-client;
}

/// Generic, invocation-scoped byte streams and staged output. Resources are
/// host-owned; references never expose filesystem paths or storage details.
interface io-host {
    /// Metadata facet. The host validates non-empty schema text and JSON
    /// structure only (object root, no duplicate members at any depth).
    /// Ownership and revision/evolution meaning, plus credential/secret
    /// exclusion, are producer obligations. Core keeps domain JSON opaque and
    /// does not infer producer conformance. See protocol/shared-values.md.
    record plugin-metadata {
        schema: string,
        json: string,
    }

    /// An already-preserved, host-owned concrete representation supplied for
    /// read-only use during an invocation. `id` is its stable durable Asset
    /// identity. `reference` is an opaque locator, not a path, URL, durable
    /// source identity, or bearer capability; the string alone grants nothing.
    /// The host grants it by supplying this Asset through the lifecycle's
    /// defined input mechanism. It is usable only with the corresponding
    /// lifecycle host's mediated `open-asset`, and only for that invocation.
    /// Copying or persisting the string creates no authority elsewhere. See
    /// protocol/preserved-asset-grants.md.
    record preserved-asset {
        id: string,
        reference: string,
        media-type: option<string>,
        size-bytes: u64,
        metadata: list<plugin-metadata>,
    }

    /// Opaque host-owned selector for a configured credential. Knowing its id
    /// alone does not authorize use; the host requires an invocation grant and
    /// rechecks authorization and availability when access is attempted.
    record credential-reference {
        id: string,
    }

    /// A plugin-defined credential slot bound by the host to one authorized
    /// reference for this invocation. The host provides these bindings to
    /// lifecycle calls and rechecks them when HTTP or helper access is used.
    /// Helper calls use the name as the helper environment variable receiving
    /// that credential; the host does not infer provider semantics.
    record credential-binding {
        name: string,
        reference: credential-reference,
    }

    /// Immutable host-issued receipt for one completed artifact registered in
    /// this invocation. Every use must match all descriptor fields to the
    /// host-recorded value; see protocol/staging.md.
    record staged-artifact {
        reference: string,
        media-type: option<string>,
        size-bytes: u64,
        metadata: list<plugin-metadata>,
    }

    variant stream-error {
        denied,
        missing,
        failed(string),
    }

    variant staging-error {
        denied,
        failed(string),
    }

    record helper-result {
        exit-code: s32,
        stdout: string,
        stderr: string,
    }

    variant helper-error {
        denied,
        credential-denied,
        credential-unavailable,
        input-failed(string),
        unavailable(string),
        failed(string),
    }

    /// The host chooses returned bytes so the encoded response fits the
    /// plugin-advertised RPC receive-frame maximum; no hidden chunk byte limit
    /// applies. `none` alone signals sticky EOF; successful chunks are non-empty.
    /// `some([])` is invalid protocol behavior. The stream is invocation-scoped
    /// and closed when
    /// dropped or when the invocation ends. See protocol/shared-values.md.
    resource byte-stream {
        read: func() -> result<option<list<u8>>, stream-error>;
    }

    /// Opens a reader over a completed artifact produced in this invocation.
    /// The host validates the reference and exact canonical descriptor before
    /// opening. Unknown references return missing; descriptor mismatches are
    /// denied. The byte range follows the shared model in
    /// protocol/byte-ranges.md, after reference validation and using canonical
    /// host-recorded size-bytes; invalid offsets return stream-error.denied.
    /// Staged authority and lifecycle are specified in protocol/staging.md.
    open-staged-artifact: func(artifact: staged-artifact, offset: u64, length: option<u64>) -> result<byte-stream, stream-error>;

    /// Appends one byte chunk to unpublished staged output. The encoded request
    /// must fit the host-advertised RPC receive-frame maximum; no smaller hidden
    /// RPC byte ceiling applies. Any ordinary write error makes the writer
    /// unfinalizable, so its partial output is discarded when dropped.
    /// `finish` is the only operation that creates a staged-artifact.
    /// Dropping an unfinished writer discards its partial output. Completed
    /// artifacts remain invocation-scoped; the host makes available only
    /// artifacts returned by a successful plugin result and discards the rest.
    resource staged-writer {
        write: func(bytes: list<u8>) -> result<_, staging-error>;
        finish: func() -> result<staged-artifact, staging-error>;
    }

    /// Starts a new output owned by this invocation. The host tracks its byte
    /// size and keeps it unpublished until the writer is successfully finished.
    resource staging-area {
        create: func(media-type: option<string>, metadata: list<plugin-metadata>) -> result<staged-writer, staging-error>;
    }

    open-staging-area: func() -> staging-area;

    /// Runs a host-approved helper. Named credentials are exposed to the helper
    /// as environment variables and never passed in `args` or returned to the
    /// plugin. Each selected binding must be authorized for this invocation
    /// and available at use time. With `input`, the host streams the supplied
    /// bytes to stdin and takes ownership of the stream until EOF or helper
    /// termination. With
    /// `output`, stdout bytes are streamed
    /// directly into that writer and the returned stdout is empty. A helper or
    /// output-stream failure makes the writer unfinalizable. Otherwise
    /// stdout and stderr are bounded diagnostic text. The host exposes no path
    /// or implicit mount to the helper.
    run-helper: func(name: string, args: list<string>, input: option<byte-stream>, output: option<borrow<staged-writer>>, credentials: list<credential-binding>) -> result<helper-result, helper-error>;
}
