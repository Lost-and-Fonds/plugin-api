package stashd:plugin@0.9.0;

interface enrichment-host {
    use io-host.{byte-stream, plugin-metadata};

    /// An existing durable Asset belonging to an Item. `reference` is an
    /// opaque host-issued locator and does not imply a filesystem path or URL.
    record asset {
        id: string,
        reference: string,
        media-type: option<string>,
        size-bytes: u64,
        metadata: list<plugin-metadata>,
    }

    record item-context {
        item-id: string,
        assets: list<asset>,
        metadata: list<plugin-metadata>,
    }

    variant asset-error {
        denied,
        missing,
        failed(string),
    }

    /// Opens a host-controlled bounded stream over an optional byte range of
    /// an existing Asset, scoped to this enrichment invocation.
    /// Supplying `offset` and `length` supports partial reads without random
    /// access to a host path.
    open-asset: func(reference: string, offset: u64, length: option<u64>) -> result<byte-stream, asset-error>;
    report-progress: func(stage: string, fraction: option<f32>);
    log: func(message: string);
}

interface enrichment-plugin {
    use enrichment-host.{asset, item-context};
    use io-host.{plugin-metadata, staged-artifact};

    /// An opaque, plugin-owned operation and revision that apply to the
    /// supplied Item/Asset context. The host does not interpret either value.
    /// `options` describes accepted invocation settings; it is not part of
    /// capability identity. An empty list represents a fixed capability.
    record capability {
        id: string,
        revision: string,
        options: list<configuration-option>,
    }

    /// One generic caller-selectable setting advertised by a capability.
    record configuration-option {
        key: string,
        label: string,
        required: bool,
        choices: list<configuration-choice>,
    }

    /// One accepted opaque string value and its human-readable label.
    record configuration-choice {
        value: string,
        label: string,
    }

    /// A caller's selected value for one advertised configuration option.
    record configuration-value {
        key: string,
        value: string,
    }

    /// A durable Asset derived from one or more existing Assets. Provenance
    /// names the plugin-owned activity and its version; source IDs refer to
    /// Assets in the supplied context.
    record derived-asset {
        artifact: staged-artifact,
        derived-from: list<string>,
        activity: string,
        activity-version: string,
    }

    record enrichment-result {
        metadata: list<plugin-metadata>,
        assets: list<derived-asset>,
    }

    record error {
        message: string,
        retryable: bool,
    }

    variant plugin-error {
        unsupported(error),
        not-found(error),
        authentication(error),
        rate-limited(error),
        unavailable(error),
        invalid-configuration(error),
        invalid-data(error),
        failed(error),
    }

    /// Return the operations that are applicable to this Item/Asset context.
    capabilities: func(context: item-context) -> list<capability>;

    /// Run one previously declared capability with the caller's selections
    /// and return plugin-owned metadata and/or durable derived Assets. The
    /// plugin validates selections against the capability's advertised
    /// options and reports invalid values with `invalid-configuration`.
    enrich: func(context: item-context, capability: capability, configuration: list<configuration-value>) -> result<enrichment-result, plugin-error>;
}

world enrichment-world {
    import io-host;
    import enrichment-host;
    export enrichment-plugin;
}
