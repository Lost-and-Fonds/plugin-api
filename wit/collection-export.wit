package stashd:plugin@0.15.0;

interface collection-export-plugin {
    use plugin-types.{plugin-error-detail};
    variant option-value {
        boolean(bool),
        number(s64),
        text(string),
    }

    record setting {
        key: string,
        value: option-value,
    }

    record collection-entry {
        title: string,
        kind: string,
        label: string,
        reference: string,
    }

    record collection {
        reference: option<string>,
        title: option<string>,
        /// Inline interchange input, bounded by the host's configured maximum
        /// serialized invocation-message size; entry count is not universal.
        entries: list<collection-entry>,
    }

    record exported-artifact {
        filename: string,
        media-type: string,
        /// Inline bytes, bounded by the host's configured maximum artifact
        /// size. The complete serialized result must also fit the RPC limit.
        contents: list<u8>,
    }

    variant plugin-error {
        unsupported(plugin-error-detail),
        not-found(plugin-error-detail),
        authentication(plugin-error-detail),
        rate-limited(plugin-error-detail),
        unavailable(plugin-error-detail),
        invalid-data(plugin-error-detail),
        /// Reserved for the host runtime when the input message, artifact bytes,
        /// or serialized result exceeds its configured limit; plugins MUST NOT
        /// return this case.
        limit-exceeded(plugin-error-detail),
        failed(plugin-error-detail),
    }

    /// One-shot bounded interchange. The host rejects input over its configured
    /// request-message limit before invocation and output over its artifact or
    /// response-message limit before accepting it, normalizing either case to
    /// `limit-exceeded`.
    export-collection: func(exporter: string, collection: collection, options: list<setting>) -> result<exported-artifact, plugin-error>;
}

world collection-export-world {
    import plugin-types;
    import logging-host;
    export collection-export-plugin;
}
