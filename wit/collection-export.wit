package stashd:plugin@0.18.0;

interface collection-export-plugin {
    use plugin-types.{plugin-error-detail};
    variant option-value {
        boolean(bool),
        number(s64),
        text(string),
    }

    record setting {
        key: string,
        value: option-value,
    }

    record collection-entry {
        reference: string,
        title: option<string>,
    }

    record collection {
        title: option<string>,
        /// Inline interchange input. The complete encoded lifecycle request MUST
        /// fit the host-advertised RPC receive-frame maximum; entry count has no
        /// separate universal limit or hidden smaller request-message byte ceiling.
        entries: list<collection-entry>,
    }

    record exported-artifact {
        filename: string,
        media-type: string,
        /// Inline bytes. A host MAY enforce an explicit Collection Export artifact
        /// size limit. Independently, the complete encoded lifecycle response MUST
        /// fit the plugin-advertised RPC receive-frame maximum; there is no
        /// separate hidden encoded-response ceiling.
        contents: list<u8>,
    }

    variant plugin-error {
        unsupported(plugin-error-detail),
        not-found(plugin-error-detail),
        authentication(plugin-error-detail),
        rate-limited(plugin-error-detail),
        unavailable(plugin-error-detail),
        invalid-data(plugin-error-detail),
        /// Reserved for the host runtime when an explicit Collection Export
        /// artifact/domain constraint is exceeded. RPC frame-size failures are not
        /// `limit-exceeded`; plugins MUST NOT return this case.
        limit-exceeded(plugin-error-detail),
        failed(plugin-error-detail),
    }

    /// One-shot bounded interchange. Request and response frames MUST fit the
    /// receiver's negotiated RPC receive maximum. The host may separately reject
    /// an explicit Collection Export artifact/domain constraint with
    /// `limit-exceeded`. Transport oversize is not normalized to that lifecycle
    /// error.
    export-collection: func(exporter: string, collection: collection, options: list<setting>) -> result<exported-artifact, plugin-error>;
}

world collection-export-world {
    import plugin-types;
    import logging-host;
    export collection-export-plugin;
}
