package stashd:plugin@0.18.0;

interface input-host {
    use io-host.{credential-reference, plugin-metadata};

    variant credential-error {
        denied,
        unavailable,
    }

    /// Raw-secret access for protocol clients the host cannot mediate. The
    /// resource is scoped to this Input invocation and closed with it.
    resource credential-access {
        read: func() -> result<string, credential-error>;
    }

    /// Opens only a reference granted to this Input invocation. Authorization
    /// and current availability are checked by the host; `denied` and
    /// `unavailable` remain distinct.
    open-credential: func(reference: credential-reference) -> result<credential-access, credential-error>;

    /// An opaque reference for another Input to resolve. The host retains the
    /// discovered item as the source of this handoff and does not inspect the
    /// reference's format or meaning.
    record input-delegation {
        reference: string,
    }

    /// The complete Item, especially stable `id` and opaque `reference`,
    /// supports a later independent acquire with its options and credentials;
    /// it does not depend on prior process-local state. Values are opaque to
    /// Core and neither identity implies a URL or media type. Size-value
    /// semantics are in protocol/input-values.md.
    record discovered-item {
        id: string,
        reference: string,
        delegation: option<input-delegation>,
        size-bytes: option<u64>,
        size-estimated: bool,
        metadata: list<plugin-metadata>,
    }

    /// Opaque plugin-owned restart point for one in-progress run. It is
    /// self-sufficient across process boundaries and contains no credentials.
    /// The host stores
    /// it unchanged, and advances it only atomically with the accepted batch.
    record discovery-continuation {
        value: string,
    }

    /// Opaque plugin-owned baseline used only between successfully completed runs.
    record discovery-refresh-state {
        value: string,
    }

    /// Retryability for a coherent but incomplete preservation result, distinct
    /// from plugin-error-detail.retryable execution-failure retryability.
    enum deficiency-disposition {
        retryable,
        terminal,
        unknown,
    }

    /// Human-readable diagnostic with opaque plugin-owned evidence facets.
    record outcome-diagnostic {
        message: string,
        evidence: list<plugin-metadata>,
    }

    record deficiency {
        disposition: deficiency-disposition,
        diagnostic: outcome-diagnostic,
    }

    /// `partial` requires at least one deficiency. Only `exhaustive` may replace
    /// the completed refresh baseline; other finishes preserve it.
    variant discovery-finish {
        exhaustive(option<discovery-refresh-state>),
        partial(list<deficiency>),
        indeterminate(outcome-diagnostic),
    }

    /// A finished batch is terminal and commits its coverage with its Items.
    variant discovery-progress {
        more(discovery-continuation),
        finished(discovery-finish),
    }

    record discovery-batch {
        items: list<discovered-item>,
        progress: discovery-progress,
    }

    variant discovery-commit-error {
        rejected,
    }

    /// MUST atomically accept every Item and its progress transition. Success means
    /// both survive invocation failure. The host MUST enforce the active request's
    /// maximum, reject commits outside an active run and after terminal completion,
    /// and retain committed state even if acknowledgment is lost. Terminal success
    /// is the run's durable commit point; later errors MUST NOT roll it back.
    commit-discovery-batch: func(batch: discovery-batch) -> result<_, discovery-commit-error>;
}

interface input-plugin {
    use input-host.{discovered-item, input-delegation, discovery-continuation, discovery-refresh-state, deficiency};
    use io-host.{credential-binding, plugin-metadata, staged-artifact};
    use plugin-types.{plugin-error-detail};

    variant option-value {
        boolean(bool),
        number(s64),
        text(string),
    }

    record source-value {
        key: string,
        value: option-value,
    }

    record input-option {
        key: string,
        value: option-value,
    }

    enum discovery-intent {
        refresh,
        complete,
    }

    /// A run's identity, intent, options, and refresh baseline must remain fixed
    /// when resuming. Continuations contain no credential material.
    /// `maximum-items-per-batch` MUST be greater than zero and is an upper
    /// count bound. The producer may send fewer Items to fit the negotiated RPC
    /// receive-frame maximum; both constraints apply independently.
    record discovery-request {
        input-id: string,
        intent: discovery-intent,
        options: list<input-option>,
        continuation: option<discovery-continuation>,
        refresh-state: option<discovery-refresh-state>,
        maximum-items-per-batch: u32,
    }

    record acquisition-options {
        options: list<input-option>,
        credentials: list<credential-binding>,
    }

    /// `complete` covers this Item's intended acquisition scope for this invocation,
    /// not discovery exhaustiveness. Partial results retain valid artifacts and
    /// require at least one deficiency. Only returned artifacts from a successful
    /// result may be adopted, together with this outcome as one durable fact.
    variant preservation-outcome {
        complete,
        partial(list<deficiency>),
    }

    record acquisition-result {
        artifacts: list<staged-artifact>,
        outcome: preservation-outcome,
    }

    /// `id` is the Input identity used as `discovery-request.input-id`; it
    /// must support later independent discover calls without prior process
    /// state. `canonical-reference`, when present, stays opaque and must not
    /// require a transient process-local association with the ID. Size-value
    /// semantics are in protocol/input-values.md.
    record resolved-input {
        id: string,
        canonical-reference: option<string>,
        estimated-item-count: option<u32>,
        size-bytes: option<u64>,
        size-estimated: bool,
        metadata: list<plugin-metadata>,
    }

    variant plugin-error {
        unsupported(plugin-error-detail),
        not-found(plugin-error-detail),
        credential-denied(plugin-error-detail),
        credential-unavailable(plugin-error-detail),
        authentication(plugin-error-detail),
        rate-limited(plugin-error-detail),
        unavailable(plugin-error-detail),
        invalid-data(plugin-error-detail),
        failed(plugin-error-detail),
    }

    resolve: func(source: list<source-value>, credentials: list<credential-binding>) -> result<resolved-input, plugin-error>;
    /// Resolve a handoff delegated by another Input. Inputs that cannot
    /// handle it return `unsupported`; Core may probe other installed Inputs.
    resolve-delegation: func(delegation: input-delegation, credentials: list<credential-binding>) -> result<resolved-input, plugin-error>;
    /// Success requires an acknowledged terminal batch; otherwise it is a protocol
    /// violation and MUST NOT complete the run. After terminal acknowledgment, the
    /// plugin MUST return success without further discovery or batch commits.
    /// Every batch MUST respect the request limit; providers' own pagination stays plugin-owned.
    discover: func(request: discovery-request, credentials: list<credential-binding>) -> result<_, plugin-error>;
    acquire: func(item: discovered-item, options: acquisition-options) -> result<acquisition-result, plugin-error>;
}

world input-world {
    import io-host;
    import input-host;
    import http-host;
    import progress-host;
    import plugin-types;
    import logging-host;
    export input-plugin;
}
