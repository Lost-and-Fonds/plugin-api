package stashd:plugin@0.11.0;

interface input-host {
    use io-host.{credential-reference, plugin-metadata};

    variant credential-error {
        denied,
        unavailable,
    }

    /// Raw-secret access for protocol clients the host cannot mediate. The
    /// resource is scoped to this Input invocation and closed with it.
    resource credential-access {
        read: func() -> result<string, credential-error>;
    }

    /// Opens only a reference granted to this Input invocation. Authorization
    /// and current availability are checked by the host; `denied` and
    /// `unavailable` remain distinct.
    open-credential: func(reference: credential-reference) -> result<credential-access, credential-error>;

    /// An opaque reference for another Input to resolve. The host retains the
    /// discovered item as the source of this handoff and does not inspect the
    /// reference's format or meaning.
    record input-delegation {
        reference: string,
    }

    /// `id` is a stable plugin identity and `reference` is an opaque locator;
    /// neither implies a URL or a media type.
    record discovered-item {
        id: string,
        reference: string,
        delegation: option<input-delegation>,
        size-bytes: option<u64>,
        size-estimated: bool,
        metadata: list<plugin-metadata>,
    }

    report-discovered: func(item: discovered-item);
}

interface input-plugin {
    use input-host.{discovered-item, input-delegation};
    use io-host.{credential-binding, plugin-metadata, staged-artifact};
    use plugin-types.{plugin-error-detail};

    variant option-value {
        boolean(bool),
        number(s64),
        text(string),
    }

    record source-value {
        key: string,
        value: option-value,
    }

    record input-option {
        key: string,
        value: option-value,
    }

    enum discovery-intent {
        refresh,
        complete,
    }

    record acquisition-options {
        options: list<input-option>,
        credentials: list<credential-binding>,
    }

    record acquisition-result {
        artifacts: list<staged-artifact>,
    }

    /// `canonical-reference`, when present, is an opaque plugin reference.
    record resolved-input {
        id: string,
        canonical-reference: option<string>,
        estimated-item-count: option<u32>,
        size-bytes: option<u64>,
        size-estimated: bool,
        metadata: list<plugin-metadata>,
    }

    variant plugin-error {
        unsupported(plugin-error-detail),
        not-found(plugin-error-detail),
        credential-denied(plugin-error-detail),
        credential-unavailable(plugin-error-detail),
        authentication(plugin-error-detail),
        rate-limited(plugin-error-detail),
        unavailable(plugin-error-detail),
        invalid-data(plugin-error-detail),
        failed(plugin-error-detail),
    }

    resolve: func(source: list<source-value>, credentials: list<credential-binding>) -> result<resolved-input, plugin-error>;
    /// Resolve a handoff delegated by another Input. Inputs that cannot
    /// handle it return `unsupported`; Core may probe other installed Inputs.
    resolve-delegation: func(delegation: input-delegation, credentials: list<credential-binding>) -> result<resolved-input, plugin-error>;
    discover: func(input-id: string, intent: discovery-intent, options: list<input-option>, credentials: list<credential-binding>) -> result<list<discovered-item>, plugin-error>;
    acquire: func(item: discovered-item, options: acquisition-options) -> result<acquisition-result, plugin-error>;
}

world input-world {
    import io-host;
    import input-host;
    import http-host;
    import progress-host;
    import plugin-types;
    import logging-host;
    export input-plugin;
}
