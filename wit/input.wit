package stashd:plugin@0.3.0;

interface input-host {
    enum http-method {
        get,
        post,
        put,
        patch,
        delete,
    }

    record http-header {
        name: string,
        value: string,
    }

    record http-request {
        method: http-method,
        url: string,
        credential: option<string>,
        headers: list<http-header>,
        body: list<u8>,
    }

    record http-response {
        status: u16,
        headers: list<http-header>,
        body: list<u8>,
    }

    variant http-error {
        denied,
        credential-unavailable,
        authentication-rejected,
        rate-limited,
        unavailable(string),
        failed(string),
    }

    resource http-client {
        request: func(request: http-request) -> result<http-response, http-error>;
    }

    open-http-client: func() -> http-client;

    /// One plugin-owned metadata facet. `schema` is a stable, versioned
    /// plugin schema identifier; `json` is its UTF-8 JSON object payload.
    record plugin-metadata {
        schema: string,
        json: string,
    }

    record helper-result {
        exit-code: s32,
        stdout: string,
        stderr: string,
    }

    variant helper-error {
        denied,
        unavailable(string),
        failed(string),
    }

    /// A staged representation described without a domain-specific Asset role.
    record staged-artifact {
        reference: string,
        media-type: option<string>,
        size-bytes: u64,
        metadata: list<plugin-metadata>,
    }

    variant staging-error {
        invalid-reference,
        missing,
        failed(string),
    }

    resource staging-area {
        run-helper: func(name: string, args: list<string>) -> result<helper-result, helper-error>;
        stage: func(relative-path: string, media-type: option<string>) -> result<staged-artifact, staging-error>;
    }

    open-staging-area: func() -> staging-area;

    record progress {
        stage: string,
        fraction: option<f64>,
    }

    /// `id` is a stable plugin identity and `reference` is an opaque locator;
    /// neither implies a URL or a media type.
    record discovered-item {
        id: string,
        reference: string,
        size-bytes: option<u64>,
        size-estimated: bool,
        metadata: list<plugin-metadata>,
    }

    report-progress: func(progress: progress);
    report-discovered: func(item: discovered-item);
    log: func(message: string);
}

interface input-plugin {
    use input-host.{discovered-item, plugin-metadata, staged-artifact};

    variant option-value {
        boolean(bool),
        number(s64),
        text(string),
    }

    record source-value {
        key: string,
        value: option-value,
    }

    record input-option {
        key: string,
        value: option-value,
    }

    /// Invocation-scoped raw secret, supplied only when the host grants raw access.
    record input-credential {
        key: string,
        value: string,
    }

    enum discovery-intent {
        refresh,
        complete,
    }

    record acquisition-options {
        options: list<input-option>,
        credentials: option<list<input-credential>>,
    }

    record acquisition-result {
        artifacts: list<staged-artifact>,
    }

    /// `canonical-reference`, when present, is an opaque plugin reference.
    record resolved-input {
        id: string,
        canonical-reference: option<string>,
        estimated-item-count: option<u32>,
        size-bytes: option<u64>,
        size-estimated: bool,
        metadata: list<plugin-metadata>,
    }

    record error {
        message: string,
        retryable: bool,
    }

    variant plugin-error {
        unsupported(error),
        not-found(error),
        authentication(error),
        rate-limited(error),
        unavailable(error),
        invalid-data(error),
        failed(error),
    }

    resolve: func(source: list<source-value>) -> result<resolved-input, plugin-error>;
    discover: func(input-id: string, intent: discovery-intent, options: list<input-option>) -> result<list<discovered-item>, plugin-error>;
    acquire: func(item: discovered-item, options: acquisition-options) -> result<acquisition-result, plugin-error>;
}

world input-world {
    import input-host;
    export input-plugin;
}
