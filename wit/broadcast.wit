package stashd:plugin@0.16.0;

interface broadcast-host {
    use io-host.{byte-stream, plugin-metadata, preserved-asset, stream-error};

    /// Stable preserved Item identity, concrete Assets, and plugin-owned metadata facets.
    record item {
        id: string,
        assets: list<preserved-asset>,
        metadata: list<plugin-metadata>,
    }

    variant collection-read-error {
        rejected,
        limit-exceeded,
        unavailable(string),
        failed(string),
    }

    /// Reads the invocation's fixed selected collection in bounded forward batches.
    /// max-items must be positive; successful batches are non-empty and none means
    /// sticky EOF. The host may return fewer than requested or the semantic count
    /// maximum to fit the requester's negotiated RPC frame maximum.
    /// The host creates this resource for one publication; it is invalid at invocation end.
    resource item-collection {
        next: func(max-items: u32) -> result<option<list<item>>, collection-read-error>;
    }

    variant publication-report-error {
        rejected,
        limit-exceeded,
        failed(string),
    }

    /// Accumulates bounded provisional result batches for one publication invocation.
    resource publication-reporter {
        report-files: func(files: list<published-file>) -> result<_, publication-report-error>;
        report-destination-metadata: func(metadata: list<plugin-metadata>) -> result<_, publication-report-error>;
    }

    /// A path reported by a filesystem-oriented destination, relative to that
    /// destination's namespace; it is never a Vault or host filesystem path.
    record published-file {
        item-id: option<string>,
        asset-id: option<string>,
        relative-path: string,
    }

    /// Opens a byte-stream over a preserved Asset using its opaque reference.
    /// After reference/authority validation, the host applies the shared range
    /// model in protocol/byte-ranges.md; an invalid offset returns
    /// stream-error.denied. Range extent is independent of RPC frame size.
    open-asset: func(reference: string, offset: u64, length: option<u64>) -> result<byte-stream, stream-error>;
}

interface broadcast-plugin {
    use io-host.{credential-binding, plugin-metadata, staged-artifact};
    use plugin-types.{plugin-error-detail};
    use broadcast-host.{item-collection, publication-reporter};
    variant option-value {
        boolean(bool),
        number(s64),
        text(string),
    }

    /// Plugin-owned settings carry configuration only, never credential
    /// references or secret material; use the invocation credential bindings.
    record setting {
        key: string,
        value: option-value,
    }

    /// The host-selected preserved collection for this invocation only.
    record publish-request {
        collection: item-collection,
        reporter: publication-reporter,
        maximum-report-records-per-batch: u32,
    }

    /// Plugin-owned non-secret configuration for the host-selected destination.
    /// Core persists these values and supplies them on every publication call.
    record destination-configuration {
        settings: list<setting>,
    }

    enum file-report-status {
        not-applicable,
        complete,
    }

    record publication {
        /// Optional local staged output. The host adopts it only when this
        /// publication result succeeds; remote-only publication uses `none`.
        artifact: option<staged-artifact>,
        files: file-report-status,
    }

    /// A plugin-defined interactive operation on destination configuration or
    /// state. It is independent of publishing Items and returns UI choices or
    /// values; it is not a publication phase or a generic arbitrary RPC.
    record operation-request {
        /// Stable plugin-defined operation name.
        name: string,
        settings: list<setting>,
        /// Operation-specific caller input, represented as string settings.
        payload: list<setting>,
    }

    record choice {
        value: string,
        label: string,
    }

    record operation-result {
        choices: list<choice>,
        values: list<setting>,
    }

    variant plugin-error {
        unsupported(plugin-error-detail),
        not-found(plugin-error-detail),
        authentication(plugin-error-detail),
        rate-limited(plugin-error-detail),
        unavailable(plugin-error-detail),
        invalid-data(plugin-error-detail),
        failed(plugin-error-detail),
    }

    /// The complete publication operation. A plugin may perform any
    /// destination-specific selection, transformation, packaging, upload, or
    /// commit work inside this call. It may stage bytes and reopen them during
    /// this invocation. There is no required prepare or finalize call.
    /// Credentials, destination configuration, and staged resources are scoped to this invocation.
    publish: func(request: publish-request, configuration: destination-configuration, credentials: list<credential-binding>) -> result<publication, plugin-error>;

    /// Runs an explicitly requested plugin-defined interactive destination
    /// operation, independently of publication. It does not publish the
    /// request's Items and its result is not publication state.
    operation: func(request: operation-request, credentials: list<credential-binding>) -> result<operation-result, plugin-error>;
}

world broadcast-world {
    import io-host;
    import broadcast-host;
    import http-host;
    import progress-host;
    import plugin-types;
    import logging-host;
    export broadcast-plugin;
}
