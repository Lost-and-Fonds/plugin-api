package stashd:plugin@0.15.0;

interface broadcast-host {
    use io-host.{byte-stream, stream-error};

    /// A path reported by a filesystem-oriented destination, relative to that
    /// destination's namespace; it is never a Vault or host filesystem path.
    record published-file {
        item-id: option<string>,
        asset-id: option<string>,
        relative-path: string,
    }

    /// Opens bounded chunks from a preserved resource using its opaque
    /// reference. The host retains control of storage and path resolution.
    open-asset: func(reference: string, offset: u64, length: option<u64>) -> result<byte-stream, stream-error>;
}

interface broadcast-plugin {
    use io-host.{credential-binding, plugin-metadata, staged-artifact};
    use plugin-types.{plugin-error-detail};
    use broadcast-host.{published-file};
    variant option-value {
        boolean(bool),
        number(s64),
        text(string),
    }

    /// Provider-owned settings carry configuration only, never credential
    /// references or secret material; use the invocation credential bindings.
    record setting {
        key: string,
        value: option-value,
    }

    /// A concrete preserved representation. `reference` is opaque and is
    /// opened only through the host's bounded Asset stream.
    record asset {
        id: string,
        /// Opaque host-issued locator used only by `open-asset`.
        reference: string,
        media-type: option<string>,
        size-bytes: u64,
        metadata: list<plugin-metadata>,
    }

    /// Stable preserved Item identity, its concrete Assets, and plugin-owned
    /// metadata facets. Domain fields remain inside those facets.
    record item {
        /// Stable host identity for the preserved logical Item.
        id: string,
        assets: list<asset>,
        metadata: list<plugin-metadata>,
    }

    record source {
        reference: string,
        settings: list<setting>,
    }

    record publish-request {
        reference: string,
        settings: list<setting>,
        sources: list<source>,
        items: list<item>,
    }

    record publication {
        /// Optional local staged output. The host adopts it only when this
        /// publication result succeeds; remote-only publication uses `none`.
        artifact: option<staged-artifact>,
        /// Present only when the destination exposes filesystem-relative paths.
        files: option<list<published-file>>,
        /// Opaque plugin-owned destination receipts, including multiple remote
        /// objects or records where needed.
        destination-metadata: list<plugin-metadata>,
    }

    /// A plugin-defined interactive operation on destination configuration or
    /// state. It is independent of publishing Items and returns UI choices or
    /// values; it is not a publication phase or a generic arbitrary RPC.
    record operation-request {
        /// Stable plugin-defined operation name.
        name: string,
        settings: list<setting>,
        /// Operation-specific caller input, represented as string settings.
        payload: list<setting>,
    }

    record choice {
        value: string,
        label: string,
    }

    record operation-result {
        choices: list<choice>,
        values: list<setting>,
    }

    variant plugin-error {
        unsupported(plugin-error-detail),
        not-found(plugin-error-detail),
        authentication(plugin-error-detail),
        rate-limited(plugin-error-detail),
        unavailable(plugin-error-detail),
        invalid-data(plugin-error-detail),
        failed(plugin-error-detail),
    }

    /// The complete publication operation. A plugin may perform any
    /// destination-specific selection, transformation, packaging, upload, or
    /// commit work inside this call. It may stage bytes and reopen them during
    /// this invocation. There is no required prepare or finalize call.
    /// Credentials and staged resources are scoped to this invocation.
    publish: func(request: publish-request, credentials: list<credential-binding>) -> result<publication, plugin-error>;

    /// Runs an explicitly requested plugin-defined interactive destination
    /// operation, independently of publication. It does not publish the
    /// request's Items and its result is not publication state.
    operation: func(request: operation-request, credentials: list<credential-binding>) -> result<operation-result, plugin-error>;
}

world broadcast-world {
    import io-host;
    import broadcast-host;
    import http-host;
    import progress-host;
    import plugin-types;
    import logging-host;
    export broadcast-plugin;
}
