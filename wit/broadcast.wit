package stashd:plugin@0.12.0;

interface broadcast-host {
    use io-host.{byte-stream, stream-error};

    record published-file {
        item-id: string,
        source-reference: string,
        relative-path: string,
    }

    /// Opens bounded chunks from a preserved resource using its opaque
    /// reference. The host retains control of storage and path resolution.
    open-asset: func(reference: string, offset: u64, length: option<u64>) -> result<byte-stream, stream-error>;
}

interface broadcast-plugin {
    use io-host.{credential-binding, staged-artifact};
    use plugin-types.{plugin-error-detail};
    use broadcast-host.{published-file};
    variant option-value {
        boolean(bool),
        number(s64),
        text(string),
    }

    /// Provider-owned settings carry configuration only, never credential
    /// references or secret material; use the invocation credential bindings.
    record setting {
        key: string,
        value: option-value,
    }

    record item-resource {
        reference: string,
        kind: string,
        derivation-key: option<string>,
        url: option<string>,
        media-type: option<string>,
        size-bytes: u64,
    }

    record item {
        id: string,
        source-reference: option<string>,
        title: string,
        description: option<string>,
        published-at: option<string>,
        duration-seconds: option<u32>,
        resources: list<item-resource>,
    }

    record source {
        reference: string,
        settings: list<setting>,
    }

    record publish-request {
        reference: string,
        settings: list<setting>,
        sources: list<source>,
        items: list<item>,
    }

    record publication {
        artifact: staged-artifact,
        files: list<published-file>,
        published-metadata: list<setting>,
    }

    record finalization-request {
        request: publish-request,
        publication: publication,
    }

    record operation-request {
        name: string,
        settings: list<setting>,
        payload: list<setting>,
    }

    record choice {
        value: string,
        label: string,
    }

    record operation-result {
        choices: list<choice>,
        values: list<setting>,
    }

    record derived-artifact {
        item-id: string,
        reference: string,
        derived-from-reference: string,
        derivation-key: string,
        kind: string,
        media-type: option<string>,
        size-bytes: u64,
    }

    record preparation {
        artifacts: list<derived-artifact>,
    }

    variant plugin-error {
        unsupported(plugin-error-detail),
        not-found(plugin-error-detail),
        authentication(plugin-error-detail),
        rate-limited(plugin-error-detail),
        unavailable(plugin-error-detail),
        invalid-data(plugin-error-detail),
        failed(plugin-error-detail),
    }

    /// Credentials are host-granted for this invocation. All phases receive
    /// the same model because preparation, publication, finalization, or
    /// destination operations may need authenticated access.
    prepare: func(request: publish-request, credentials: list<credential-binding>) -> result<preparation, plugin-error>;
    publish: func(request: publish-request, credentials: list<credential-binding>) -> result<publication, plugin-error>;
    finalize: func(request: finalization-request, credentials: list<credential-binding>) -> result<publication, plugin-error>;
    operation: func(request: operation-request, credentials: list<credential-binding>) -> result<operation-result, plugin-error>;
}

world broadcast-world {
    import io-host;
    import broadcast-host;
    import http-host;
    import progress-host;
    import plugin-types;
    import logging-host;
    export broadcast-plugin;
}
