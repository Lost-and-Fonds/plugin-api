#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
temporary_root="$(mktemp -d)"
trap 'rm -rf "$temporary_root"' EXIT

wasm-tools component wit "$repo_root/wit" --json >/dev/null

python3 "$repo_root/tools/extract_wit.py" \
    --repo-root "$repo_root" --output-dir "$temporary_root/first"
python3 "$repo_root/tools/extract_wit.py" \
    --repo-root "$repo_root" --output-dir "$temporary_root/second"

for artifact in wit-schema.json compatibility-report.md plugin-package.schema.json; do
    diff -u "$repo_root/schema/$artifact" "$temporary_root/first/$artifact"
    cmp "$temporary_root/first/$artifact" "$temporary_root/second/$artifact"
done

python3 "$repo_root/tools/verify_generated_contract.py" \
    "$temporary_root/first/wit-schema.json" \
    "$temporary_root/first/plugin-package.schema.json"
python3 "$repo_root/tools/verify_rpc_v1.py" \
    "$repo_root/protocol/rpc-v1.md" \
    "$repo_root/protocol/rpc-v1-vectors.json" \
    "$temporary_root/first/wit-schema.json"
python3 "$repo_root/tools/verify_package_artifact.py" \
    "$temporary_root/first/plugin-package.schema.json" \
    "$repo_root/protocol/package-artifact-vectors.json"
python3 "$repo_root/tools/verify_package_contract.py" \
    "$temporary_root/first/plugin-package.schema.json" \
    "$repo_root/protocol/package-contract-vectors.json"
python3 "$repo_root/tools/verify_input_routing.py"
python3 "$repo_root/tools/verify_byte_ranges.py"
python3 "$repo_root/tools/verify_preserved_asset_grants.py"
python3 "$repo_root/tools/verify_helper_process.py"
python3 "$repo_root/tools/test_contract_sensitivity.py" \
    "$temporary_root/first/wit-schema.json" \
    "$temporary_root/first/plugin-package.schema.json"
