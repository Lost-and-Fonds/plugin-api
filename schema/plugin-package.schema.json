{
  "$defs": {
    "component": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "description": "Portable logical package path using `/` separators; see protocol/package-artifact.md for normalization, containment, and symlink rules.",
          "minLength": 1,
          "pattern": "^[^/\\\\:\\u0000-\\u001F\\u007F][^\\\\:\\u0000-\\u001F\\u007F]*$",
          "type": "string"
        },
        "world": {
          "description": "Canonical WIT world implemented by this component.",
          "enum": [
            "broadcast-world",
            "collection-export-world",
            "enrichment-world",
            "input-world"
          ],
          "type": "string"
        }
      },
      "required": [
        "world",
        "artifact"
      ],
      "type": "object"
    }
  },
  "$id": "https://stashd.dev/schemas/plugin-package.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One deployable package identity may contain one or more identified components implementing canonical WIT worlds.",
  "properties": {
    "components": {
      "additionalProperties": {
        "$ref": "#/$defs/component"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "type": "object"
    },
    "id": {
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "components"
  ],
  "title": "Stashd Plugin Package Manifest",
  "type": "object",
  "x-stashd-contract-package": "stashd:plugin@0.16.0"
}
